# Default settings for the final dissertation pipeline
PIPELINE_MODEL_PROVIDER=mock
PIPELINE_MODEL_NAME=mock-model

# OpenRouter real LLM settings. Keep blank until needed.
# For free testing, use PIPELINE_MODEL_NAME=openrouter/free and provide an OpenRouter key.
PIPELINE_OPENROUTER_API_KEY=
PIPELINE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
PIPELINE_MODEL_TEMPERATURE=0
PIPELINE_MODEL_MAX_OUTPUT_TOKENS=8192
PIPELINE_MODEL_REQUEST_TIMEOUT_SECONDS=120

PIPELINE_WORKSPACE_ROOT=workspaces
PIPELINE_RESULTS_DIRECTORY=results
PIPELINE_LOG_DIRECTORY=logs
PIPELINE_TEST_TIMEOUT_SECONDS=2400
PIPELINE_MAX_CONTEXT_FILES=5
PIPELINE_MAX_SOURCE_CHARACTERS=50000
PIPELINE_MAX_FAILURE_OUTPUT_CHARACTERS=12000
PIPELINE_CONTEXT_USE_BENCHMARK_HINTS=false
PIPELINE_HUMAN_APPROVAL_REQUIRED=true

# Python/BugsInPy support. setup_wsl.sh fills this value after cloning BugsInPy.
PIPELINE_BUGSINPY_EXECUTABLE_DIRECTORY=

# Java/Defects4J support. Leave blank if defects4j is already on PATH.
# If not on PATH, set this to the directory containing the defects4j executable.
PIPELINE_DEFECTS4J_EXECUTABLE_DIRECTORY=
